# Copy this file to .env (git-ignored) and fill in real values.
# NEVER commit real API keys. This file only documents which variables
# the app looks for; see biscuit/config.py for how each is resolved.

# Required only when narration.provider: elevenlabs
ELEVENLABS_API_KEY=

# Required only when image.provider: openai
# Also reserved for a future LLM story-expansion provider.
OPENAI_API_KEY=

# Required only when image.provider: xai
XAI_API_KEY=

# YouTube publishing (youtube.enabled: true) does NOT use an environment
# variable. It uses OAuth credential files instead:
#   secrets/youtube_client_secret.json
#   secrets/youtube_token.json
# See README.md. Never commit those files.
