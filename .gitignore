# Python
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets — never commit these
.env
*.env.local

# YouTube OAuth client secret / cached refresh token
secrets/*
